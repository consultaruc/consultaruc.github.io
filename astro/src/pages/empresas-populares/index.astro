                <span class="rc-avatar">{initial(c.razonSocial)}</span>
                <div class="rc-ht">
                  <strong class="rc-name">{c.razonSocial}</strong>
                  <div class="rc-ruc">
                    <span class="dc-seg">{c.ruc.slice(0, 2)}</span>
                    <span class="dc-seg dc-seg-mid">{c.ruc.slice(2, 10)}</span>
                    <span class="dc-seg">{c.ruc.slice(10)}</span>
                  </div>
                </div>
              </div>
              <div class="rc-pills">
                {c.estado && <span class={pillClass(c.estado)}>{c.estado}</span>}
                {c.condicion && <span class={pillClass(c.condicion)}>{c.condicion}</span>}
              </div>
              {c.domicilioFiscal && (
                <div class="rc-dom"><span class="ic" data-icon="map-pin"></span> {shortDom(c.domicilioFiscal)}</div>
              )}
              {firstActividad(c.actividadEconomica) && (
                <span class="rc-act">{firstActividad(c.actividadEconomica)}</span>
