---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMostSearchedCompanies } from '../../lib/db.js';
import { CURATED_RUCS } from '../../lib/indexableRucs.js';
import { RUC_PROFILES } from '../../lib/rucProfiles.js';

// El bloque curado de arriba se mantiene tal cual: son las empresas grandes
// elegidas a mano y no dependen de lo que pase con el tráfico. Esto es una
// sección aparte, alimentada por lo que la gente busca de verdad.
//
// No es el widget de "consultas recientes" que se quitó en su día: aquel
// enseñaba lo último que había buscado cualquiera, en todas las páginas, y de
// ahí salían RUC al azar hacia el sitemap. Aquí sólo entra lo MÁS buscado de
// los últimos 30 días, sólo en esta página, y con el mismo filtro de calidad
// que usa el sitemap (ficha con domicilio fiscal).
// CURATED_RUCS son los 36 RUC del directorio curado de abajo, para no
// repetirlos aquí arriba. La lista vive en indexableRucs.js porque también
// decide qué fichas se indexan; si se añade una empresa al directorio, su RUC
// va allí.

// La lista del directorio también como ItemList, sacada de los mismos perfiles
// que pintan las fichas: así el schema no puede quedarse atrás de las tarjetas.
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Directorio de Empresas Populares en Perú - Consulta RUC',
  url: 'https://consultaruc-pe.com/empresas-populares/',
  description: 'Directorio de las empresas y entidades públicas más consultadas del Perú: BCP, Plaza Vea, SUNAT, EsSalud, Ministerio Público y más. Consulta su RUC y estado.',
  inLanguage: 'es-PE',
  isPartOf: { '@type': 'WebSite', name: 'Consulta RUC Perú', url: 'https://consultaruc-pe.com' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: Object.entries(RUC_PROFILES)
      .filter(([, p]) => p.directory !== false)
      .map(([ruc, p], i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.brand} – RUC ${ruc}`, url: `https://consultaruc-pe.com/ruc/${ruc}` }))
  }
};

const mostSearched = getMostSearchedCompanies(720, 24)
  .filter((c) => !CURATED_RUCS.has(c.ruc))
  .slice(0, 12);

const initial = (name) => (name || '?').trim().charAt(0).toUpperCase();
const shortDom = (d) => {
  if (!d) return '';
  // El padrón escribe la cola como "… DEPARTAMENTO - PROVINCIA - DISTRITO";
  // para una tarjeta basta con esa cola, no con la calle entera.
  const parts = String(d).split('-').map((p) => p.trim()).filter(Boolean);
  return parts.length >= 2 ? parts.slice(-2).reverse().join(', ') : String(d).slice(0, 40);
};
// actividad_economica se guarda como JSON (la ficha en vivo trae varias); en
// una tarjeta cabe una, así que se coge la primera.
const firstActividad = (raw) => {
  if (!raw) return '';
  try {
    const list = JSON.parse(raw);
    return Array.isArray(list) ? String(list[0] || '') : String(list || '');
  } catch {
    return String(raw);
  }
};
const pillClass = (v) => {
  const s = String(v || '').toUpperCase();
  if (s === 'ACTIVO' || s === 'HABIDO') return 'dc-pill dc-active';
  if (s === 'NO HABIDO' || s.startsWith('SUSPENSION')) return 'dc-pill warn';
  return 'dc-pill bad';
};
