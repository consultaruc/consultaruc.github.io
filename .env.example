# ── ConsultaRUC.pe — environment variables ──────────────────────────────────
# Copy to `.env` and adjust. All are OPTIONAL (the app runs with sane defaults).

# Port the Express server listens on.
PORT=3000

# "production" enables secure cookies (HTTPS-only), etc. Leave unset for local dev.
NODE_ENV=production

# Canonical absolute origin used for canonical URLs, sitemap, OG and print.
# If unset, the app defaults to https://consultaruc-pe.com.
SITE_URL=https://consultaruc-pe.com

# How many enriched RUC pages to include in sitemap.xml (pacing lever for a new
# domain; raise as Search Console shows healthy indexing: 1000 -> 10000 -> 50000).
SITEMAP_MAX_RUCS=1000
