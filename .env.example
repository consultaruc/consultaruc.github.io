# ── ConsultaRUC.pe — environment variables ──────────────────────────────────
# Copy to `.env` and adjust. All are OPTIONAL (the app runs with sane defaults).

# Port the Astro/Node server listens on.
PORT=3000

# "production" enables secure cookies (HTTPS-only), etc. Leave unset for local dev.
NODE_ENV=production

# Canonical absolute origin used for canonical URLs, sitemap, OG and print.
# If unset, the app defaults to https://consultaruc-pe.com.
SITE_URL=https://consultaruc-pe.com

# Where the SQLite DB (consulta_ruc.sqlite) and admin_credentials.json live.
# Defaults to <cwd>/data - only set this if running from a working directory
# other than the repo root (see astro/src/lib/db.js).
# DATA_DIR=/absolute/path/to/data

# Where astro/src/pages/admin/{login,dashboard}.ts read their HTML from (read
# from disk per-request, not bundled). Defaults to <cwd>/src/adminAssets,
# which only resolves correctly if cwd is the astro/ directory itself - in
# production PM2's cwd is the repo root (see ecosystem.config.js), so this
# must be set explicitly there.
# ADMIN_ASSETS_DIR=/absolute/path/to/astro/src/adminAssets
