# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── SUNAT bulk data — huge (400MB+), re-downloadable, never commit ───────────
data/downloads/
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# ── Secrets & per-environment files ─────────────────────────────────────────
data/admin_credentials.json
.env
.env.local
.env.production
.env.*.local

# ── Sessions (if a file-based session store is enabled) ─────────────────────
sessions/

# ── Large RAW source images. The OPTIMIZED versions the site serves live in
#    src/public/img/ and ARE committed. Brand logo source (*.png) is kept.
assets/source-images/**/*.jpeg
assets/source-images/**/*.jpg

# ── Build output / caches ───────────────────────────────────────────────────
dist/
.astro/
.cache/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
